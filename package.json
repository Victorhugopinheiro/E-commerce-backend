{
  "name": "backend-commerce",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "types:generate": "mtgen src/model --output src/types/mongoose.gen.ts --dates-as-strings --no-mongoose",
    "types:copy": "shx mkdir -p ../ecommerce-frontend/src/types && shx cp src/types/mongoose.gen.ts ../ecommerce-frontend/src/types/mongoose.gen.ts",
    "types:sync": "npm run types:generate && npm run types:copy",
    "backfill:gta-franchise": "ts-node src/scripts/backfill-gta-franchise.ts",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cloudinary": "^1.41.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.18.0",
    "multer": "^2.0.2",
    "multer-storage-cloudinary": "^4.0.0",
    "razorpay": "^2.9.6",
    "stripe": "^18.5.0",
    "validator": "^13.15.15"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.1",
    "@types/validator": "^13.15.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "mongoose-tsgen": "^9.5.6",
    "nodemon": "^3.1.10",
    "prettier": "^3.10.1",
    "shx": "^0.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
